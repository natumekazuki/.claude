{
  "model": "claude-sonnet-5-5",
  "modelSettings": {
    "claude-sonnet-5-5": {
      "effortLevel": "medium"
    },
    "claude-opus-5-5": {
      "effortLevel": "low"
    }
  },
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-sonnet-5-5",
    "CLAUDE_CODE_FORK_SUBAGENT": "0",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1",
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "24"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& (Join-Path ([Environment]::GetFolderPath('UserProfile')) '.claude/hooks/implementation-restraint.ps1')"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& (Join-Path ([Environment]::GetFolderPath('UserProfile')) '.claude/hooks/implementation-restraint.ps1')"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& (Join-Path ([Environment]::GetFolderPath('UserProfile')) '.claude/hooks/implementation-restraint.ps1')"
          }
        ]
      }
    ]
  }
}
